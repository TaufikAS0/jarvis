# Required API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FISH_API_KEY=your-fish-audio-api-key-here

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe
# Optional: Separate Fish Audio voice model for Indonesian mode
# FISH_VOICE_ID_ID=your-indonesian-fish-voice-id
# Optional: Public Indonesian fallback voice used only when the active voice is English-only
# FISH_VOICE_ID_ID_FALLBACK=9edf80f1aa8743608817c0d8f415f974
# Optional: Force the Fish TTS backend explicitly (`s2-pro` recommended)
# FISH_TTS_BACKEND=s2-pro
# Optional: Enable verbose TTS debug logging
# FISH_TTS_DEBUG=0

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony
# USER_LOCATION=Cimahi
# USER_COUNTRY=Indonesia
# USER_TIMEZONE=Asia/Jakarta
# USER_LANGUAGE=en

# Optional: Specific Apple Calendar accounts to read (comma-separated emails)
# If not set, JARVIS reads ALL calendars from Apple Calendar
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com

# Optional: Which coding agent JARVIS should hand project work to.
# On Windows, `codex` is a good default for desktop handoff.
# DEV_AGENT=codex

# Optional: Anthropic model selection for JARVIS itself.
# The main chat/reasoning model benefits from a stronger default.
# JARVIS_CHAT_MODEL=claude-sonnet-4-6
# JARVIS_FAST_MODEL=claude-haiku-4-5-20251001
# JARVIS_RESEARCH_MODEL=claude-opus-4-6
# Optional: LLM provider selection.
# JARVIS_LLM_PROVIDER=anthropic
# For a local OpenAI-compatible server such as LM Studio:
# JARVIS_LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# JARVIS_LOCAL_LLM_MODEL=
# JARVIS_LOCAL_LLM_API_KEY=lm-studio
# For NVIDIA NIM / DeepSeek free-trial endpoint:
# JARVIS_LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=your-nvidia-nim-api-key-here
# JARVIS_NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# JARVIS_NVIDIA_LLM_MODEL=deepseek-ai/deepseek-v4-pro
# Optional: Ultra-economy mode.
# Make Haiku the default chat model, then fall back to Sonnet only when the
# request looks complex or the first response sounds uncertain.
# JARVIS_CHAT_FALLBACK_MODEL=claude-sonnet-4-6
# JARVIS_ULTRA_ECO_MODE=1
# Optional: keep a local rule-based fallback active when Anthropic is unavailable.
# JARVIS_LOCAL_FALLBACK_MODE=1
#
# Optional: show a browser text chat box for typed commands.
# Useful on tablet/mobile when microphone permission or HTTPS trust is not ready.
# JARVIS_CHAT_BOX_ENABLED=0
#
# Optional: offline speech-to-text settings for faster-whisper.
# CPU mode is the safest default on Windows and avoids missing CUDA DLL errors.
# JARVIS_WHISPER_MODEL=small
# JARVIS_WHISPER_DEVICE=cpu
# JARVIS_WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# Local TTS (offline mode — replaces Fish Audio)
# ---------------------------------------------------------------------------
# Set JARVIS_TTS_PROVIDER=local to use a local TTS server instead of Fish Audio.
# Choose the local engine with JARVIS_LOCAL_TTS_ENGINE:
#   kokoro -> lightweight Kokoro ONNX server on port 8881
#   voxcpm -> VoxCPM2 server on port 8882
#
# JARVIS_TTS_PROVIDER=local
# JARVIS_LOCAL_TTS_ENGINE=kokoro
# JARVIS_LOCAL_TTS_URL=http://127.0.0.1:8881
# JARVIS_LOCAL_TTS_VOICE=bm_george
# JARVIS_LOCAL_TTS_VOICE_ID=
# JARVIS_LOCAL_TTS_SPEED=1.0
#
# Optional for VoxCPM2:
# JARVIS_LOCAL_TTS_ENGINE=voxcpm
# JARVIS_LOCAL_TTS_URL=http://127.0.0.1:8882
# JARVIS_LOCAL_TTS_MODEL_PATH=D:\AI Project\VoxCPM2
#
# Available Kokoro voices (English):
#   bm_george  — British male (closest to JARVIS MCU)
#   bm_lewis   — British male alternative
#   am_michael — American male
#   af_heart   — American female
#   bf_emma    — British female
